{
  "name": "aloysius",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "valibot": "^1.5.0",
      "typescript": "^6.0.3",
      "varlock": "1.18.0",
      "@stylexjs/stylex": "^0.19.0",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.8",
      "@libsql/client": "0.18.0",
      "libsql": "0.5.29",
      "@orpc/server": "^1.15.0",
      "@orpc/client": "^1.15.0",
      "@orpc/openapi": "^1.15.0",
      "@orpc/valibot": "^1.15.0",
      "better-auth": "1.7.3",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "vitest": "^5.0.0",
      "jsdom": "^30.0.1",
      "@testing-library/react": "^16.3.3",
      "@testing-library/dom": "^10.4.1",
      "@testing-library/jest-dom": "^7.0.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run dev:infra && bun run dev:db && nx run-many -t dev",
    "dev:infra": "docker compose -f docker-compose.dev.yml up -d",
    "dev:db": "bun run db:migrate",
    "build": "nx run-many -t build",
    "check-types": "nx run-many -t check-types",
    "test": "nx run-many -t test",
    "postinstall": "tsc -b packages/api && varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "dev:types": "tsc -b packages/api --watch",
    "dev:web": "nx run-many -t dev --projects=web",
    "db:push": "nx run-many -t db:push --projects=@aloysius/db",
    "db:studio": "nx run-many -t db:studio --projects=@aloysius/db",
    "db:generate": "nx run-many -t db:generate --projects=@aloysius/db",
    "db:migrate": "nx run-many -t db:migrate --projects=@aloysius/db",
    "db:local": "nx run-many -t db:local --projects=@aloysius/db",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./packages/db/",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {},
  "devDependencies": {
    "@aloysius/config": "workspace:*",
    "@types/node": "^26.4.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "nx": "^23.2.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-plugin-react-doctor": "^0.9.13",
    "typescript": "catalog:",
    "ultracite": "7.11.1",
    "varlock": "catalog:"
  },
  "packageManager": "bun@1.4.0"
}
