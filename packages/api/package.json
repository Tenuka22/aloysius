{
  "name": "@aloysius/api",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./*": {
      "types": "./dist/src/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@aloysius/auth": "workspace:*",
    "@aloysius/db": "workspace:*",
    "@aloysius/storage": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/publisher": "^1.14.11",
    "@orpc/server": "catalog:",
    "drizzle-orm": "1.0.0-rc.4",
    "sharp": "^0.35.4",
    "valibot": "catalog:"
  },
  "devDependencies": {
    "@aloysius/config": "workspace:*",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
