{
  "references": [{ "path": "../../packages/api" }],
  "include": ["**/*.ts", "**/*.tsx"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    /*
     * ES2023 for `Array.prototype.toSorted` and friends. The lint rules require
     * the non-mutating form, and the runtime is Node 22 and current browsers,
     * both of which have had it for years. `target` stays at ES2022 because
     * nothing here needs downlevelling that far.
     */
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "paths": {
      "@/*": ["./src/*"],
      "@aloysius/ui/*": ["../../packages/ui/src/*"]
    }
  }
}
