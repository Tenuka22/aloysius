# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
TURSO_DATABASE_URL=

# @public @type=email
ADMIN_EMAIL=admin@example.com

# @type=string(minLength=8)
ADMIN_PASSWORD=

# Local file storage (LMDB) - used everywhere except production, where MinIO
# takes over. Resolved the same way TURSO_DATABASE_URL's file: path is, relative to
# apps/web/.
# @type=string(minLength=1)
FILE_STORAGE_DIR=../../data

# libsql-server auth token - only set this (in .env.production) if the sqld
# container has SQLD_HTTP_AUTH/SQLD_AUTH_JWT_KEY configured.
# @required=false
# @type=string
TURSO_AUTH_TOKEN=

# MinIO / S3-compatible object storage - production only.
# @public @type=string(minLength=1)
MINIO_ENDPOINT=localhost

# @public @type=number
MINIO_PORT=9000

# @type=string(minLength=1)
MINIO_ACCESS_KEY=minioadmin

# @type=string(minLength=1)
MINIO_SECRET_KEY=minioadmin

# @public @type=string(minLength=1)
MINIO_BUCKET=aloysius

# @public @type=boolean
MINIO_USE_SSL=false
