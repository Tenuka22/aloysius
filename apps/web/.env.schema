# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @public @dynamic @type=url
BETTER_AUTH_URL=

# @type=string(minLength=1)
TURSO_DATABASE_URL=

# @public @type=string(minLength=1)
ADMIN_USERNAME=admin

# Better Auth's tanstackStartCookies plugin passes request context through an
# internal Response during sign-in, triggering varlock's scanner on a body that
# never reaches the client. preventLeaks=false silences this false positive.
# @sensitive={preventLeaks=false} @type=string(minLength=8)
ADMIN_PASSWORD=

# CMS editor account - can only edit and publish homepage content (see the
# `cms` role in packages/auth/src/permissions.ts). Seeded the same way as
# ADMIN_USERNAME/ADMIN_PASSWORD above.
# @public @type=string(minLength=1)
CMS_USERNAME=cms

# @sensitive={preventLeaks=false} @type=string(minLength=8)
CMS_PASSWORD=

# @type=string(minLength=1)
TURSO_DATABASE_URL=

# libsql-server auth token - only set this (in .env.production) if the sqld
# container has SQLD_HTTP_AUTH/SQLD_AUTH_JWT_KEY configured.
# @required=false
# @type=string
TURSO_AUTH_TOKEN=

# MinIO / S3-compatible object storage - production only.
# @public @type=string(minLength=1)
MINIO_ENDPOINT=localhost

# @public @type=number
MINIO_PORT=9000

# @type=string(minLength=1)
MINIO_ACCESS_KEY=minioadmin

# @type=string(minLength=1)
MINIO_SECRET_KEY=minioadmin

# @public @type=string(minLength=1)
MINIO_BUCKET=aloysius

# @public @type=boolean
MINIO_USE_SSL=false
