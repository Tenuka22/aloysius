# Production/Docker Compose topology overrides. Loaded automatically by
# varlock when NODE_ENV=production (see @currentEnv in .env.schema).
#
# The build stage has no access to real secrets (no BuildKit secret mount,
# and .env/.env.local stay out of the build context per .dockerignore), but
# `vite build` still validates the full schema, so BETTER_AUTH_SECRET,
# BETTER_AUTH_URL, ADMIN_PASSWORD, and CMS_PASSWORD below are build-time-only
# placeholders.
# They are never used at runtime: docker-compose.yml's env_file (apps/web/.env)
# and environment overrides set real process env vars when the container
# starts, and varlock always prefers a real environment variable over a value
# from a checked-in .env.production file.
BETTER_AUTH_SECRET=build-time-placeholder-not-used-at-runtime-32c
BETTER_AUTH_URL=http://localhost:3001
ADMIN_PASSWORD=build-time-placeholder
CMS_PASSWORD=build-time-placeholder

# turso-db (libsql-server) service from docker-compose.yml.
TURSO_DATABASE_URL=http://turso-db:8080

# minio service from docker-compose.yml.
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=aloysius
MINIO_USE_SSL=false
